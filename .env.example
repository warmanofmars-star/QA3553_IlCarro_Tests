# Образец настроек. Скопируй в .env и поправь под себя; сам .env в git не попадает.
# Все переменные читает только config.py. Переменная, заданная в окружении (compose, CI, оболочка),
# важнее значения из .env.

# --- Адреса приложения ---
# Фронтенд (UI)
UI_BASE_URL=https://icarro-v1.netlify.app
# Бэкенд (API)
API_BASE_URL=https://ilcarro-backend.herokuapp.com

# --- Запуск браузеров ---
# true: браузер без окна (локально)
HEADLESS_MODE=true
# true: Selenium-тесты идут в браузерах Selenium Grid (нужен запущенный Grid), false: браузер на этой машине
USE_GRID=false
# Адрес хаба Selenium Grid (используется при USE_GRID=true); порт — тот же, что GRID_HOST_PORT ниже
# GRID_URL=http://localhost:4444
# Папка с видео сессий Grid; видео из неё прикладывается к отчёту Allure. Её задаёт docker-compose.yml
# (/app/video). При локальном запуске против Grid видео лежит в Docker-томе — оставь пустой
# VIDEO_DIR=
# true: запуск на раннере GitHub Actions без Grid; CI-системы задают её сами, локально не нужна
# CI=false

# --- Docker Compose (эти две переменные читает сам docker compose из .env, а не config.py) ---
# Какие узлы браузеров запускать: профиль compose = браузер (chrome, firefox, edge).
# Тот же браузер передаётся тестам в BROWSER
# COMPOSE_PROFILES=chrome
# Порт Grid на хосте (Grid UI: http://localhost:4444/ui/). Меняй, если 4444 занят другим стендом
# GRID_HOST_PORT=4444

# --- Таймауты ---
# Ожидания Playwright, миллисекунды
PW_TIMEOUT=10000

# --- Логи ---
# true: дублировать логи в консоль
ENABLE_CONSOLE_LOGS=true

# --- Telegram (уведомления о прогоне) ---
TELEGRAM_TOKEN=your_telegram_token
TELEGRAM_TO=your_chat_id
