# Образец настроек. Скопируй в .env и поправь под себя; сам .env в git не попадает.
# Все переменные читает только config.py. Переменная, заданная в окружении (compose, CI, оболочка),
# важнее значения из .env.

# --- Адреса приложения ---
# Фронтенд (UI)
UI_BASE_URL=https://icarro-v1.netlify.app
# Бэкенд (API)
API_BASE_URL=https://ilcarro-backend.herokuapp.com

# --- Запуск браузеров ---
# true: браузер без окна (локально)
HEADLESS_MODE=true
# true: Selenium-тесты идут в браузерах Selenoid (нужен запущенный Selenoid), false: браузер на этой машине
USE_SELENOID=false
# Адрес хаба Selenoid (используется при USE_SELENOID=true)
SELENOID_HUB_URL=http://localhost:4444/wd/hub
# Папка с видео сессий Selenoid; видео из неё прикладывается к отчёту Allure
VIDEO_DIR=C:\selenoid\video
# true: запуск на раннере GitHub Actions без Selenoid; CI-системы задают её сами, локально не нужна
# CI=false

# --- Таймауты ---
# Ожидания Playwright, миллисекунды
PW_TIMEOUT=10000

# --- Логи ---
# true: дублировать логи в консоль
ENABLE_CONSOLE_LOGS=true

# --- Telegram (уведомления о прогоне) ---
TELEGRAM_TOKEN=your_telegram_token
TELEGRAM_TO=your_chat_id
