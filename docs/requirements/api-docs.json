              "*/*": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ErrorMessageDtoMapStringString"
                    },
                    {
                      "type": "object"
                    },
                    {
                      "$ref": "#/components/schemas/ErrorMessageDtoString"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessageDtoString"
                }
              }
            }
          },
          "500": {
